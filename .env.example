# Local setup: cp .env.example .env.local
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Base URL of the Admin app (patient intake calls Admin /api/patients and /api/drive/upload).
# Use the URL where Admin runs locally (default Next port is 3000).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Twilio Verify — WhatsApp OTP (server-only; never use NEXT_PUBLIC_ prefix)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
